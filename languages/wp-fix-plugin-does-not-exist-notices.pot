#. Plugin Name of the plugin
#: wp-fix-plugin-does-not-exist-notices.php
msgid "Fix 'Plugin file does not exist' Notices"
msgstr ""

#. Plugin URI of the plugin
#: wp-fix-plugin-does-not-exist-notices.php
msgid "https://github.com/wpallstars/wp-fix-plugin-does-not-exist-notices"
msgstr ""

#. Description of the plugin
#: wp-fix-plugin-does-not-exist-notices.php
msgid "Explains the \"Plugin file does not exist\" message on the Plugins screen and cleans up what deleted plugins leave behind."
msgstr ""

#. Author of the plugin
#: wp-fix-plugin-does-not-exist-notices.php
msgid "Marcus Quinn"
msgstr ""

#. Author URI of the plugin
#: wp-fix-plugin-does-not-exist-notices.php
msgid "https://www.wpallstars.com/"
msgstr ""

#: includes/Plugin.php:175
msgid "About the “Plugin file does not exist” message"
msgstr ""

#. translators: %s: list of plugin files.
#: includes/Plugin.php:179
#, php-format
msgid "WordPress could not find %s, so it has switched it off. Nothing else has changed, and your other plugins keep working."
msgid_plural "WordPress could not find %s, so it has switched them off. Nothing else has changed, and your other plugins keep working."
msgstr[0] ""
msgstr[1] ""

#: includes/Plugin.php:185
msgid "If it was deleted on purpose, there is nothing more to do, and the message will not appear again. If not, install it again and activate it."
msgid_plural "If they were deleted on purpose, there is nothing more to do, and the message will not appear again. If not, install them again and activate them."
msgstr[0] ""
msgstr[1] ""

#: includes/Plugin.php:186
msgid "If the message comes back, something on the server keeps switching the plugin on, such as a deployment tool or a must-use plugin."
msgstr ""

#. translators: %d: number of entries.
#: includes/Plugin.php:193
#, php-format
msgid "Removed %d leftover entry for a deleted plugin."
msgid_plural "Removed %d leftover entries for deleted plugins."
msgstr[0] ""
msgstr[1] ""
